# 复制为 .env；不可将真实值提交到 Git。
POSTGRES_DB=na_web
POSTGRES_USER=na_app
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
APP_SECRET_KEY=replace-with-a-long-random-application-secret
BOOTSTRAP_ADMIN_PASSWORD=replace-with-admin-initial-password-at-least-12-chars
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
WEB_PUBLIC_URL=https://na.example.com
REQUIRE_EMAIL_VERIFICATION=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=mailer@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=NA 自动配置 <mailer@example.com>
WEB_PORT=8000
